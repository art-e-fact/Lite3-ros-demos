<mujoco model="karuizawa">
  <!-- Blender Y-up OBJ: euler 90 deg about X maps (x, y, z) -> (x, -z, y).
       pos z lifts the spawn dip at (-5, 0) so local ground is near z=0.
       One mesh per cube so MuJoCo convex-hulls them separately. -->
  <compiler angle="degree" meshdir="." />
  <option gravity="0 0 -9.81" />

  <asset>
    <mesh name="cube" file="cube.obj" />
    <mesh name="cube_001" file="cube_001.obj" />
    <mesh name="cube_002" file="cube_002.obj" />
    <mesh name="cube_003" file="cube_003.obj" />
    <mesh name="cube_004" file="cube_004.obj" />
    <mesh name="cube_005" file="cube_005.obj" />
    <mesh name="cube_006" file="cube_006.obj" />
    <material name="terrain" rgba="0.55 0.52 0.45 1" />
  </asset>

  <worldbody>
    <light name="sun" directional="true" pos="10 -10 20" dir="-0.3 0.3 -1" diffuse="0.9 0.88 0.82" />
    <body name="karuizawa" pos="0 0 1.66" euler="90 0 0">
      <geom name="cube" type="mesh" mesh="cube" material="terrain" condim="3" friction="1 0.005 0.0001" />
      <geom name="cube_001" type="mesh" mesh="cube_001" material="terrain" condim="3" friction="1 0.005 0.0001" />
      <geom name="cube_002" type="mesh" mesh="cube_002" material="terrain" condim="3" friction="1 0.005 0.0001" />
      <geom name="cube_003" type="mesh" mesh="cube_003" material="terrain" condim="3" friction="1 0.005 0.0001" />
      <geom name="cube_004" type="mesh" mesh="cube_004" material="terrain" condim="3" friction="1 0.005 0.0001" />
      <geom name="cube_005" type="mesh" mesh="cube_005" material="terrain" condim="3" friction="1 0.005 0.0001" />
      <geom name="cube_006" type="mesh" mesh="cube_006" material="terrain" condim="3" friction="1 0.005 0.0001" />
    </body>
  </worldbody>
</mujoco>
