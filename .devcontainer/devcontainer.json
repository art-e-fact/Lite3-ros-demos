{
    "name": "ROS 2 Humble",
    "build": {
        "context": "..",
        "dockerfile": "Dockerfile",
        "options": ["--network=host"]
    },
    // Run as your host user so files have correct ownership
    "remoteUser": "root",
    "containerUser": "root",
    // GPU + display access
    "runArgs": [
        "--net=host",
        "--privileged",
        "--gpus=all",
        "--ulimit=memlock=-1:-1",
        "--env=DISPLAY=${localEnv:DISPLAY}",
        "--env=XAUTHORITY=/root/.Xauthority",
        "--env=PYOPENGL_PLATFORM=glx",
        "--env=__GLX_VENDOR_LIBRARY_NAME=nvidia",
        "--env=NVIDIA_VISIBLE_DEVICES=all",
        "--env=NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics,display",
        "--env=WAYLAND_DISPLAY=${localEnv:WAYLAND_DISPLAY}",
        "--env=XDG_RUNTIME_DIR=${localEnv:XDG_RUNTIME_DIR}",
        "--volume=/tmp/.X11-unix:/tmp/.X11-unix",
        "--volume=${localEnv:HOME}/.Xauthority:/root/.Xauthority:ro",
        "--volume=${localEnv:XDG_RUNTIME_DIR}:${localEnv:XDG_RUNTIME_DIR}",
        "--volume=/dev/input:/dev/input",
        "--device=/dev/dri"
    ],
    // Source ROS and the workspace overlay (if built) on every shell
    "postCreateCommand": "bash /workspaces/sdk_deploy/.devcontainer/post-create.sh",
    
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-iot.vscode-ros",
                "ms-vscode.cpptools",
                "ms-python.python"
            ]
        }
    }
}
